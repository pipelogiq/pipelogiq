# Common
APP_ID=PipelogiqGo
POSTGRES_USER=pipelogiq
POSTGRES_PASSWORD=pipelogiq
POSTGRES_DB=pipelogiq
DATABASE_URL=postgres://pipelogiq:pipelogiq@pipelogiq-postgres:5432/pipelogiq?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@pipelogiq-rabbitmq:5672/
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=pipelogiq-tempo:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
OTEL_SERVICE_NAME=pipelogiq-app
OTEL_SERVICE_NAME_WORKER=pipelogiq-worker

# API
HTTP_ADDR=:8080
# Required. The API refuses to start with this example value — generate your own:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:3300,http://127.0.0.1:3300
GATEWAY_VISIBILITY_TIMEOUT=60s
GATEWAY_MAX_INFLIGHT=128
RABBIT_PREFETCH=10
RABBIT_DLQ_ENABLED=true
RABBIT_DLQ_TTL=30s
WORKER_HEARTBEAT_INTERVAL=15s
WORKER_OFFLINE_AFTER=45s
WORKER_SESSION_TTL=24h
WORKER_EVENTS_MAX_BATCH=200
# Broker address handed to AMQP workers at bootstrap. Use a least-privilege
# RabbitMQ user here; leave empty to hand out RABBITMQ_URL (single-tenant only).
WORKER_RABBITMQ_URL=
# Set to false to hand out no broker address at all; workers then need
# PIPELOGIQ_RABBITMQ_URL in their own environment.
WORKER_BROKER_HANDOUT=true
# Encrypts integration secrets (bot tokens, webhook URLs, auth headers) at rest.
# Generate: openssl rand -base64 32 — the same value must reach the worker.
SECRETS_ENCRYPTION_KEY=
# Secure flag on the session cookie: auto (TLS or X-Forwarded-Proto=https), always, never.
COOKIE_SECURE=auto
LIQUIBASE_ENABLED=true
# Optional override; defaults to jdbc:postgresql://pipelogiq-postgres:5432/${POSTGRES_DB}
# LIQUIBASE_URL=jdbc:postgresql://pipelogiq-postgres:5432/pipelogiq
# Optional override; defaults to /app/database/changelog.xml in pipelogiq-api image
# LIQUIBASE_CHANGELOG_FILE=/app/database/changelog.xml

# Worker
WORKER_POLL_INTERVAL=1s
STAGE_ACTIVE_TIMEOUT=5m
WORKER_METRICS_ADDR=:9090

# Grafana. Only started with --profile observability. A host that already runs a
# collector should leave the profile off and point OTEL_EXPORTER_OTLP_ENDPOINT at it.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Application and API key provisioned on first start, so a fresh host needs no
# dashboard clicks. Leave BOOTSTRAP_APPLICATION_NAME empty to skip this entirely.
# BOOTSTRAP_API_KEY is read once and stored; generate it with `openssl rand -hex 32`.
# Both are ignored once the application exists, so rotating or revoking a key in
# the dashboard survives a restart.
BOOTSTRAP_APPLICATION_NAME=
BOOTSTRAP_API_KEY=
# Optional assertion. The queue prefix is derived from the numeric application id,
# so setting this only makes startup fail loudly if it is not what you expected.
# BOOTSTRAP_APPLICATION_APP_ID=app_1

# Administrator, provisioned on startup when the account does not exist yet.
ADMIN_EMAIL=admin@pipelogiq.local
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
# Leave ADMIN_PASSWORD_HASH empty to have a one-time random password generated and
# printed once in the API log on first start. To set your own instead:
#   htpasswd -bnBC 12 "" "yourpassword" | tr -d ':\n'
ADMIN_PASSWORD_HASH=

# Licence. Leave empty to run as Community, which is a complete deployment for a
# single developer. A licence is verified offline against a key compiled into the
# binary: Pipelogiq never phones home, and no pipeline ever stops because of one.
# An expired licence keeps its features for 14 days, then falls back to Community.
PIPELOGIQ_LICENSE=

# Pro: OIDC single sign-on. Unset SSO_ISSUER means licensed but not configured.
# A login whose groups match nothing in the map is refused, not defaulted, and
# local accounts always keep working for break-glass access.
# SSO_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_GROUP_CLAIM=groups
# SSO_GROUP_ROLE_MAP=pipelogiq-admins=Admin,pipelogiq-viewers=Viewer

# Pro: sign audit exports. Base64 of a 32-byte Ed25519 seed:
#   openssl rand 32 | base64
# Without it exports are produced but marked "algorithm": "none".
# AUDIT_EXPORT_SIGNING_KEY=
